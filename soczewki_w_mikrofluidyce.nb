Cell[TextData[{
 "Patrz\:0105c od lewej w prawo mamy dwie powierzchnie krzywizny soczewki, a \
ka\:017cdej z nich mo\:017cemy przyporz\:0105dkowa\[CAcute] promie\:0144 \
krzywizny: ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["R", "1"],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]],
  CellFrameColor->RGBColor[0, 0, 1],ExpressionUUID->
  "f2a1139b-442b-8f44-aa72-2009bdc61bc4"],
 " i ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["R", "2"],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]],ExpressionUUID->
  "83e2320c-b9ba-8547-87e6-e2cd81a243cd"],
 ". Gdy \:015brodek krzywizny danej powierzchni le\:017cy po lewej stronie od \
soczewki (powierzchnia jest wkl\:0119s\[LSlash]a dla \:015bwiat\[LSlash]a \
padaj\:0105cego z lewej) to promie\:0144 jest ujemny  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["R", "1"], "<", "0"}],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]],
  CellFrameColor->RGBColor[0, 0, 1],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "4e4de6e2-bdbb-5445-addf-c9aafc8a4fc4"],
 ". Z kolei gdy \:015brodek krzywizny powierzchni le\:017cy po prawej stronie \
od powierzchni soczewki to promie\:0144 jest dodatni ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["R", "2"], ">", "0"}],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]],
  CellFrameColor->RGBColor[0, 0, 1],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "036ce8ec-fd7c-d544-80e5-2323534adfba"],
 ".\nZak\[LSlash]adamy uproszenie, \:017ce punkty g\[LSlash]\[OAcute]wne \
schodz\:0105 si\:0119 do \:015brodka geometrycznego soczewki, ogniskow\:0105 \
soczewki mierzymy od \:015brodka odcinka ",
 StyleBox["d",
  FontColor->RGBColor[1, 0.5, 0]],
 "."
}], "Text",
 CellChangeTimes->{{4.0030550369074593`*^9, 4.003055061298998*^9}, {
  4.003055181952837*^9, 4.0030552150027485`*^9}, {4.0030552576700783`*^9, 
  4.0030553030623474`*^9}, {4.0030554407311287`*^9, 4.003055455699354*^9}, {
  4.003055617149023*^9, 4.0030556194811115`*^9}, {4.0030556553037624`*^9, 
  4.0030558521914387`*^9}, {4.003056094442749*^9, 4.003056179931242*^9}, {
  4.0030567258692055`*^9, 4.003056730217497*^9}, {4.0030677648748093`*^9, 
  4.0030677930591373`*^9}, {4.0030734605169773`*^9, 4.003073501990385*^9}, {
  4.0030749208522243`*^9, 
  4.0030749419383984`*^9}},ExpressionUUID->"abbd3eb4-7b4a-f54c-8ce7-\
e0f9a0d94e7a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Wz\[OAcute]r szlifierzy dla soczewki grubej", "Subsubsection",
 CellChangeTimes->{{4.003056065454571*^9, 
  4.0030560723694897`*^9}},ExpressionUUID->"bab2e40a-c22d-8643-acfa-\
42706746b6a9"],

Cell[TextData[{
 "Wz\[OAcute]r pozwala wyznaczy\[CAcute] oba promienie soczewki, gdy oba \
profile s\:0105 sferyczne oraz zadana jest ogniskowa ",
 StyleBox["f ",
  FontSlant->"Italic",
  FontColor->RGBColor[1, 0, 0]],
 ": "
}], "Text",
 CellChangeTimes->{{4.0030562062814865`*^9, 4.0030562852975006`*^9}, {
  4.00305635952989*^9, 4.0030563692183933`*^9}, {4.0030565372506332`*^9, 
  4.0030565391727943`*^9}, {4.0030567875344677`*^9, 
  4.003056817412756*^9}},ExpressionUUID->"e36c1925-2110-e34e-9964-\
1d6339ee2e15"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", 
    StyleBox["f",
     FontColor->RGBColor[1, 0, 0]]], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["n",
       FontColor->RGBColor[0, 0.67, 0]], "-", "1"}], ")"}], "\[CenterDot]", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       StyleBox[
        SubscriptBox["R", "1"],
        FontColor->RGBColor[0, 0, 1]]], "-", 
      FractionBox["1", 
       StyleBox[
        SubscriptBox["R", "2"],
        FontColor->RGBColor[0, 0, 1]]], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          StyleBox["n",
           FontColor->RGBColor[0, 0.67, 0]], "-", "1"}], ")"}], "\[CenterDot]", 
        StyleBox["d",
         FontColor->RGBColor[1, 0.5, 0]]}], 
       RowBox[{
        StyleBox["n",
         FontColor->RGBColor[0, 0.67, 0]], "\[CenterDot]", 
        StyleBox[
         SubscriptBox["R", "1"],
         FontColor->RGBColor[0, 0, 1]], "\[CenterDot]", 
        StyleBox[
         SubscriptBox["R", "2"],
         FontColor->RGBColor[0, 0, 1]]}]]}], ")"}]}]}], TraditionalForm]],
 FormatType->TraditionalForm,
 FontSize->22,ExpressionUUID->"5192a497-79e3-5142-a19b-d3291a0148d0"]], "Text",
 CellChangeTimes->{{4.0030564293064156`*^9, 4.00305652348814*^9}, {
  4.0030565621633606`*^9, 4.0030565753050785`*^9}, {4.003056688301733*^9, 
  4.0030566943353653`*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"8fc6aac3-ab95-b64e-b10f-61ea000181ba"],

Cell[TextData[{
 StyleBox["d",
  FontColor->RGBColor[1, 0.5, 0]],
 " - grubo\:015b\[CAcute] soczewki mierzone wzd\[LSlash]u\:017c jej osi \
optycznej,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    FractionBox[
     SubscriptBox["n", "pow"], 
     SubscriptBox["n", "PDMS"]]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontColor->RGBColor[0, 0.67, 0],ExpressionUUID->
  "3ae7a8c6-ce01-0f4a-a1be-bba47e0528cd"],
 StyleBox[" ",
  FontColor->RGBColor[0, 0.67, 0]],
 "- wzgl\:0119dny wsp\[OAcute]\[LSlash]czynnik za\[LSlash]amania \:015bwiat\
\[LSlash]a, stosunek wsp\[OAcute]\[LSlash]czynnika za\[LSlash]amania materia\
\[LSlash]u, z kt\[OAcute]rego zbudowana jest soczewka ",
 Cell[BoxData[
  SubscriptBox["n", "pow"]], "InlineCode",ExpressionUUID->
  "93fb4d1e-3b1c-9d40-9722-427a93fd19ce"],
 " do wsp\[OAcute]\[LSlash]czynnika za\[LSlash]amania otoczenia ",
 Cell[BoxData[
  SubscriptBox["n", "PDMS"]], "InlineCode",ExpressionUUID->
  "3722bb3d-bd5a-d84e-b19a-0ae18a90a6b5"],
 ", w kt\[OAcute]rym soczewka si\:0119 znajduje,\n",
 StyleBox["f ",
  FontColor->RGBColor[1., 0., 0.]],
 "- ogniskowa soczewki\n",
 Cell[BoxData[
  StyleBox[
   SubscriptBox["R", "1"],
   FontColor->RGBColor[0, 0, 1]]],
  CellChangeTimes->{{4.000195880664587*^9, 4.00019591712951*^9}, 
    4.000196648961307*^9, {4.000196791877109*^9, 4.000196899601384*^9}, 
    4.0030534655360546`*^9},
  TextAlignment->Center,ExpressionUUID->
  "ce18c690-dd81-ab4f-a88f-8a00f48f3129"],
 " - ujemny promie\:0144 lewej krzywizny soczewki,\n",
 Cell[BoxData[
  SubscriptBox["R", "2"]],
  CellChangeTimes->{{4.000195880664587*^9, 4.00019591712951*^9}, 
    4.000196648961307*^9, {4.000196791877109*^9, 4.000196899601384*^9}, 
    4.0030534655360546`*^9},
  TextAlignment->Center,
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "85f00552-b3fd-a94d-b815-2df28eda2d65"],
 " - dodatni promie\:0144 prawej krzywizny soczewki. "
}], "Text",
 CellChangeTimes->{{4.003056913394085*^9, 4.0030569337820606`*^9}, {
  4.003066754636648*^9, 4.003066821632757*^9}, {4.003067277554928*^9, 
  4.003067278185728*^9}, {4.0030686183961887`*^9, 
  4.003068699939207*^9}},ExpressionUUID->"a5f607a7-785d-6040-974f-\
c3123f1b99d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Przyk\[LSlash]ad (soczewka skupiaj\:0105ca, symetryczna ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SubscriptBox["R", "1"], "=", 
    RowBox[{"-", "R"}]}],
   FontColor->RGBColor[0, 0, 1]]],
  FontSize->19,ExpressionUUID->"b15ef3df-3e2e-8c48-9131-4dd10feacb92"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
