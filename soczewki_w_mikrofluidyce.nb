             If[$CellContext`c === {}, None, 
              First[
               MinimalBy[$CellContext`c, First]]]]]; $CellContext`refract = 
          Function[{$CellContext`v, $CellContext`n, $CellContext`n1, \
$CellContext`n2}, 
            Module[{$CellContext`nn = 
              If[Dot[$CellContext`v, $CellContext`n] > 
                0, -$CellContext`n, $CellContext`n], $CellContext`ci, \
$CellContext`eta, $CellContext`k}, $CellContext`ci = -
               Dot[$CellContext`v, $CellContext`nn]; $CellContext`eta = \
$CellContext`n1/$CellContext`n2; $CellContext`k = 
              1 - $CellContext`eta^2 (1 - $CellContext`ci^2); 
             If[$CellContext`k < 
               0, {$CellContext`v + 2 $CellContext`ci $CellContext`nn, 
                False}, {
                
                Normalize[$CellContext`eta $CellContext`v + ($CellContext`eta \
$CellContext`ci - Sqrt[$CellContext`k]) $CellContext`nn], 
                True}]]]; $CellContext`trace = 
          Function[{$CellContext`p0, $CellContext`v0}, 
            
            Module[{$CellContext`p = $CellContext`p0, $CellContext`v = \
$CellContext`v0, $CellContext`in = 
              False, $CellContext`ids = {}, $CellContext`hit, \
$CellContext`rr}, 
             Do[$CellContext`hit = $CellContext`nextHit[$CellContext`p, \
$CellContext`v]; If[$CellContext`hit === None, 
                 Break[]]; AppendTo[$CellContext`ids, 
                 Part[$CellContext`hit, 3]]; 
               If[Part[$CellContext`hit, 3] == "F", 
                 
                 Break[]]; $CellContext`rr = \
$CellContext`refract[$CellContext`v, 
                  Part[$CellContext`hit, 2], 
                  If[$CellContext`in, $CellContext`nL, $CellContext`nM], 
                  
                  If[$CellContext`in, $CellContext`nM, $CellContext`nL]]; \
$CellContext`p = $CellContext`p + 
                 Part[$CellContext`hit, 1] $CellContext`v; $CellContext`v = 
                Part[$CellContext`rr, 1]; If[
                 Part[$CellContext`rr, 2], $CellContext`in = 
                 Not[$CellContext`in]], {
               12}]; {$CellContext`ids, $CellContext`v}]]; $CellContext`kat = 
          Function[$CellContext`v, ArcTan[-Part[$CellContext`v, 1], 
              Part[$CellContext`v, 2]]/Degree]; 
         Do[$CellContext`r = $CellContext`trace[{$CellContext`xs, \
$CellContext`ys}, {
               Cos[$CellContext`a], 
               Sin[$CellContext`a]}]; If[
             And[Part[$CellContext`r, 1] =!= {}, Last[
                Part[$CellContext`r, 1]] == "F", 
              MemberQ[
               Part[$CellContext`r, 1], 
               Alternatives["R", "L", "T", "B"]], Abs[
                $CellContext`kat[
                 Part[$CellContext`r, 2]]] <= $CellContext`thAcc], 
             Increment[$CellContext`cnt]], {$CellContext`a, 2. 
            Pi (Range[
              0, $CellContext`numRays - 
               1]/$CellContext`numRays)}]; $CellContext`cnt]}; 
